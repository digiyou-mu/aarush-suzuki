# Generated by build.ps1 – server settings and 301 redirects from the old WordPress URLs
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# Preview / staging hosts stay out of search results (never matches aarushsuzuki.in)
SetEnvIfNoCase Host "hostingersite\.com$" STAGING_HOST
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=STAGING_HOST
</IfModule>

RewriteEngine On

# /index.html and /folder/index.html → the folder URL
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# Old WordPress system URLs
RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(feed|comments/feed)/?$ / [R=301,L]
RewriteRule ^(wp-admin|wp-includes|wp-json|wp-login\.php|xmlrpc\.php)(/.*)?$ - [G,L]
RewriteRule ^wp-content/ - [G,L]

# Old WordPress pages → new pages
RewriteRule ^best-suzuki-bikes-in-hyderabad/?\s*$ /about/ [R=301,L,NC,NE]
RewriteRule ^best-suzuki-motorcycles-in-hyderabad/?\s*$ /motorcycles/ [R=301,L,NC,NE]
RewriteRule ^best-suzuki-scooters-in-hyderabad/?\s*$ /scooters/ [R=301,L,NC,NE]
RewriteRule ^best-bikes-and-scooters-in-hyderabad/?\s*$ /motorcycles/ [R=301,L,NC,NE]
RewriteRule ^suzuki-e-access-on-road-price-in-hyderabad/?\s*$ /electric-vehicles/ [R=301,L,NC,NE]
RewriteRule ^e-access-on-road-price-in-hyderabad/?\s*$ /electric-vehicles/e-access/ [R=301,L,NC,NE]
RewriteRule ^best-suzuki-bike-service-in-hyderabad/?\s*$ /services/ [R=301,L,NC,NE]
RewriteRule ^reviews/?\s*$ /#reviews [R=301,L,NC,NE]
RewriteRule ^suzuki-bikes-on-road-price-in-hyderabad/?\s*$ /book-a-test-ride/ [R=301,L,NC,NE]
