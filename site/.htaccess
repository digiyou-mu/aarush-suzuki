RewriteRule ^v-strom-sx-250-ad/?\s*$ /motorcycles/v-strom-sx/ [R=301,L,NC,NE]
RewriteRule ^v-strom-sx-250-ad-copy/?\s*$ /motorcycles/v-strom-sx/ [R=301,L,NC,NE]
RewriteRule ^vstrom-sx-landing-page/?\s*$ /motorcycles/v-strom-sx/ [R=301,L,NC,NE]
